pipeline {
agent any
environment {
PROJECT = "pavan-477919"
DOCKER_REGISTRY = "docker.io/pavanyennu"
IMAGE_NAME = "${DOCKER_REGISTRY}/love"
SSH_CREDENTIALS = "ecom-deploy-ssh"
REMOTE_USER = "deploy"
REMOTE_HOST = "34.44.162.183"
REMOTE_APP_DIR = "/opt/ecom-app"
}


stages {
stage('Checkout') {
steps { checkout scm }
}


stage('GCP: fetch secrets & docker login (Workload Identity)') {
steps {
sh '''
set -eu
command -v gcloud >/dev/null 2>&1 || { echo "gcloud missing"; exit 1; }
command -v docker >/dev/null 2>&1 || { echo "docker missing"; exit 1; }


DOCKER_USER=$(gcloud secrets versions access latest --secret="docker-username" --project=${PROJECT} --format='get(payload.data)' | base64 --decode)
DOCKER_PASS=$(gcloud secrets versions access latest --secret="docker-password" --project=${PROJECT} --format='get(payload.data)' | base64 --decode)


printf '%s' "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin docker.io


unset DOCKER_PASS DOCKER_USER
'''
}
}


stage('Build Jar (containerized)') {
steps {
sh '''
set -eu


# ensure Docker exists on the agent
if ! command -v docker >/dev/null 2>&1; then
echo "ERROR: docker not found on agent. Install Docker on this node or use an agent image with Docker."
exit 1
fi


# find the directory containing pom.xml (search depth 3)
POM_PATH=$(find . -maxdepth 3 -name pom.xml -print -quit || true)
if [ -z "$POM_PATH" ]; then
echo "ERROR: no pom.xml found in workspace. Ensure the repository contains a Maven project or adjust the search depth."
exit 1
fi


POM_DIR=$(dirname "$POM_PATH")
echo "Found pom.xml in: $POM_DIR"
}
