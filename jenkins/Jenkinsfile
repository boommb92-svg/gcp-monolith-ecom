pipeline {
  agent any
  environment {
    PROJECT = "pavan-477919"
    DOCKER_REGISTRY = "docker.io/pavanyennu"
    IMAGE_NAME = "${DOCKER_REGISTRY}/love"
    REMOTE_HOST = "34.44.162.183"
  }

  stages {
    stage('Checkout') { steps { checkout scm } }

    stage('GCP: fetch secrets & docker login (Workload Identity)') {
      steps {
        sh '''
          set -eu
          command -v gcloud >/dev/null 2>&1 || { echo "gcloud missing"; exit 1; }
          command -v docker >/dev/null 2>&1 || { echo "docker missing"; exit 1; }

          DOCKER_USER=$(gcloud secrets versions access latest --secret="docker-username" --project=${PROJECT} --format='get(payload.data)' | base64 --decode)
          DOCKER_PASS=$(gcloud secrets versions access latest --secret="docker-password" --project=${PROJECT} --format='get(payload.data)' | base64 --decode)

          printf '%s' "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin docker.io

          unset DOCKER_PASS DOCKER_USER
        '''
      }
    }

    stage('Build & Push Image') {
      steps {
        script {
          // compute tag
          def shortCommit = env.GIT_COMMIT ?: sh(returnStdout: true, script: 'git rev-parse --short=8 HEAD').trim()
          shortCommit = shortCommit ?: 'latest'
          def imageTag = "${IMAGE_NAME}:${shortCommit}"
          env.IMAGE_TAG = imageTag

          sh "docker build --pull -t ${imageTag} ."
          sh "docker push ${imageTag}"
          sh "docker tag ${imageTag} ${IMAGE_NAME}:latest || true"
          sh "docker push ${IMAGE_NAME}:latest || true"
        }
      }
    }

    stage('Deploy -> MIG rolling update (no SSH)') {
  steps {
    sh '''
      set -eu

      PROJECT=pavan-477919
      ZONE=us-central1-a
      MIG_NAME=ecom-mig
      TEMPLATE_BASE=ecom-template
      IMAGE=${IMAGE_TAG}

      gcloud config set project ${PROJECT}

      NEW_TEMPLATE="${TEMPLATE_BASE}-$(date +%s)"
      echo "Creating new instance template: ${NEW_TEMPLATE} with image ${IMAGE}"

      # create template (note: NO --zone here)
      if ! gcloud compute instance-templates create-with-container "${NEW_TEMPLATE}" \
          --project=${PROJECT} \
          --container-image="${IMAGE}" \
          --container-restart-policy=always \
          --machine-type=e2-medium \
          --boot-disk-size=10GB \
          --tags=ecom-app ; then
        echo "create-with-container failed; exiting"
        exit 1
      fi

      # verify template exists
      if ! gcloud compute instance-templates describe "${NEW_TEMPLATE}" --project=${PROJECT} >/dev/null 2>&1 ; then
        echo "Template ${NEW_TEMPLATE} not found after create; aborting"
        exit 1
      fi

      echo "Starting rolling update of MIG: ${MIG_NAME} using template ${NEW_TEMPLATE}"
      gcloud compute instance-groups managed rolling-action start-update "${MIG_NAME}" \
        --version=template="${NEW_TEMPLATE}" --zone="${ZONE}" --project=${PROJECT}

      # optional: wait until stable
      gcloud compute instance-groups managed wait-until-stable "${MIG_NAME}" --zone="${ZONE}" --project=${PROJECT}
    '''
  }
}

  post {
    success { echo "Deployed ${env.IMAGE_TAG}" }
    failure { echo "Pipeline failed" }
  }
}
}
