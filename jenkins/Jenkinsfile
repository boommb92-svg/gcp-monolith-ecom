pipeline {
  agent any
  environment {
    PROJECT_ID     = "pavan-477919"                 // ensure PROJECT_ID exists (was PROJECT)
    PROJECT        = "${PROJECT_ID}"                // keep PROJECT too if other code uses it
    DOCKER_REGISTRY = "docker.io/pavanyennu"
    IMAGE_NAME     = "${DOCKER_REGISTRY}/love"
    SSH_CREDENTIALS = "ecom-deploy-ssh"
    REMOTE_USER    = "deploy"
    REMOTE_HOST    = "34.44.162.183"
    REMOTE_APP_DIR = "/opt/ecom-app"

    // MIG-specific variables — set these to match your infra
    ZONE           = "us-central1-a"                // change to your MIG's zone
    MIG_NAME       = "ecom-mig"                     // your managed instance group name
    TEMPLATE_BASE  = "ecom-template"
  }

  stages {
    // ... your existing stages (Checkout, fetch secrets, build, push, etc.) ...

    stage('Fetch Latest Template') {
      steps {
        script {
          // fail fast if any required env var is missing
          if (!env.PROJECT_ID?.trim()) {
            error "PROJECT_ID is not set"
          }
          if (!env.ZONE?.trim()) {
            error "ZONE is not set"
          }
          if (!env.MIG_NAME?.trim()) {
            error "MIG_NAME is not set"
          }

          // Get the latest instance template name (most-recent creationTimestamp)
          def latestTemplate = sh(
            script: """
              gcloud compute instance-templates list \
                --project=${env.PROJECT_ID} \
                --sort-by=~creationTimestamp \
                --format='value(name)' | head -n 1
            """,
            returnStdout: true
          ).trim()

          if (!latestTemplate) {
            echo "No instance templates found in project ${env.PROJECT_ID}"
            env.INSTANCE_TEMPLATE = ""
          } else {
            echo "Latest Instance Template: ${latestTemplate}"
            env.INSTANCE_TEMPLATE = latestTemplate
          }
        }
      }
    }

    stage('Update MIG') {
      when {
        expression { return env.INSTANCE_TEMPLATE?.trim() }
      }
      steps {
        script {
          sh """
            set -euo pipefail
            gcloud compute instance-groups managed set-instance-template ${env.MIG_NAME} \
              --template=${env.INSTANCE_TEMPLATE} \
              --zone=${env.ZONE} \
              --project=${env.PROJECT_ID}
          """
        }
      }
    }

    stage('Deploy -> MIG rolling update (no SSH)') {
      steps {
        sh '''
          set -eu

          # config (from env injected by Jenkins)
          PROJECT=${PROJECT_ID}
          ZONE=${ZONE}
          MIG_NAME=${MIG_NAME}
          TEMPLATE_BASE=${TEMPLATE_BASE}
          IMAGE=${IMAGE_TAG:-""}

          if [ -z "$IMAGE" ]; then
            echo "ERROR: IMAGE_TAG is empty. Aborting."
            exit 1
          fi

          gcloud config set project ${PROJECT}

          NEW_TEMPLATE="${TEMPLATE_BASE}-$(date +%s)"
          echo "Creating new instance template: ${NEW_TEMPLATE} with image ${IMAGE}"
          gcloud compute instance-templates create-with-container "${NEW_TEMPLATE}" \
            --project=${PROJECT} \
            --container-image="${IMAGE}" \
            --container-restart-policy=always \
            --zone=${ZONE}

          echo "Starting rolling update of MIG: ${MIG_NAME}"
          gcloud compute instance-groups managed rolling-action start-update "${MIG_NAME}" \
            --version=template="${NEW_TEMPLATE}" --zone="${ZONE}" --project=${PROJECT}

          gcloud compute instance-groups managed wait-until-stable "${MIG_NAME}" --zone="${ZONE}" --project=${PROJECT}
        '''
      }
    }

  } // stages

  post {
    success { echo "Deployed ${env.IMAGE_TAG} to ${env.REMOTE_HOST}" }
    failure { echo "Pipeline failed" }
  }
}
